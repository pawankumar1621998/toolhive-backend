{
  "name": "toolhive-backend",
  "version": "1.0.0",
  "description": "Production backend API for ToolHive – AI-powered SaaS tools platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "nodemon src/workers/index.js",
    "dev:all": "concurrently --names \"API,WORKER\" --prefix-colors \"cyan,yellow\" \"npm run dev\" \"npm run worker\""
  },
  "keywords": [
    "toolhive",
    "ai",
    "saas",
    "tools",
    "api"
  ],
  "author": "ToolHive",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "ffmpeg-static": "^5.3.0",
    "groq-sdk": "^1.1.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "openai": "^4.52.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.2",
    "stripe": "^16.2.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
